# =============================================

# IMPROVED & SAFE .htaccess (Fixed for Shared Hosting)

# =============================================

# 1. Force HTTPS + HSTS

RewriteEngine On

# Redirect everything to HTTPS

RewriteCond %{HTTPS} off
RewriteRule ^(.\*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
    # Add HSTS (tells browsers to ALWAYS use HTTPS for the next 1 year)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# 2. Modern Security Headers

<IfModule mod_headers.c>
    # Clickjacking protection
    Header always append X-Frame-Options "SAMEORIGIN"

    # Prevent MIME sniffing
    Header set X-Content-Type-Options "nosniff"

    # Enable browser XSS filter
    Header set X-XSS-Protection "1; mode=block"

    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Content Security Policy (MUST BE ON ONE LINE)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://formspree.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://formspree.io;"

    # Permissions Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # Cache Control
    Header set Cache-Control "no-store, no-cache, must-revalidate"

</IfModule>

# 3. Disable Directory Browsing

# If this causes an error, remove the line below (some hosts lock this too)

Options -Indexes

# 4. Protect sensitive files

<FilesMatch "^\.">
Order allow,deny
Deny from all
</FilesMatch>

<FilesMatch "\.(env|log|ini|bak|backup|sql|md|yml|yaml|dist|conf|lock|json|git|gitignore|htpasswd|php~)$">
Order allow,deny
Deny from all
</FilesMatch>

# 5. Block obvious bad bots

RewriteCond %{HTTP_USER_AGENT} (libwww-perl|wget|python|nikto|curl|scan|java|winhttp|clshttp|loader|zmEu|HVAC|SBID|Semrush|AhrefsBot|MJ12bot|BLEXBot|DotBot) [NC]
RewriteRule .\* - [F,L]

# 6. Force non-www (https://christopherwardconstruction.com)

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# 7. Hide Server Signature

# ServerSignature is usually allowed, but ServerTokens is NOT.

ServerSignature Off

# REMOVED: ServerTokens Prod (This caused the 500 error)
